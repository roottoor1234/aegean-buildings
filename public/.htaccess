# Apache (XAMPP / cPanel): SPA routing and security headers
Options -Indexes
DirectoryIndex index.html
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ενεργοποίησε ΜΟΝΟ αφού εγκατασταθεί έγκυρο πιστοποιητικό SSL:
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Μόνο GET/POST/PUT/DELETE/OPTIONS/HEAD
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|PUT|DELETE|OPTIONS)$
  RewriteRule ^ - [R=405,L]

  # Επιβεβαίωση SSL (Let's Encrypt), API και υπαρκτά αρχεία σερβίρονται κανονικά
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Ποτέ δημόσια: ρυθμίσεις, logs, dumps, πηγαίος κώδικας εκτός API
<FilesMatch "(^\.(?!well-known)|error_log$|\.(sql|log|bak|old|orig|swp|ini|sh|md|lock|dist|example)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Μόνο δικά μας scripts/στυλ/fonts· Google Translate για τις δημόσιες σελίδες.
  # Το sha256 επιτρέπει ΜΟΝΟ το inline script του Translate widget (αν το αλλάξει η Google, σταματά μόνο η μετάφραση).
  # Τα tracking pixels της Google μπλοκάρονται σκόπιμα.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-R6kjt5FwTd5vAw94Q08NLDZsSaGTzg4NsdIfKtECSp0=' https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://www.gstatic.com https://translate.googleapis.com; img-src 'self' data: blob: https://www.gstatic.com https://translate.google.com https://translate.googleapis.com https://fonts.gstatic.com; font-src 'self'; connect-src 'self' https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src https://translate.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" "expr=%{CONTENT_TYPE} =~ m#text/html#"
  # Μετά το SSL πρόσθεσε στο τέλος του CSP: ; upgrade-insecure-requests
  # HSTS μόνο πάνω σε HTTPS (οι browsers το αγνοούν σε μη έγκυρο πιστοποιητικό)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  # Ο κατάλογος διαχείρισης δεν ευρετηριάζεται
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{THE_REQUEST} =~ m#\s/(admin|login|api)#"

  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
