# ─── Database (XAMPP: root χωρίς κωδικό) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aegean_signage
DB_USER=root
DB_PASS=

# ─── Πρώτος διαχειριστής (δημιουργείται από το `npm run db:setup`) ───────────
